{
  "name": "arlas-wui",
  "workspaces": [
    "packages/cloud",
    "packages/opensource"
  ],
  "version": "29.0.0-rc.4",
  "author": "gisaia",
  "repository": {
    "type": "git",
    "url": "https://github.com/gisaia/ARLAS-wui.git"
  },
  "license": "Apache-2.0",
  "scripts": {
    "ng": "ng",
    "postinstall": "patch-package && patch-package --patch-dir node_modules/arlas-web-core/patches && patch-package --patch-dir node_modules/arlas-d3/patches && patch-package --patch-dir node_modules/arlas-map/patches",
    "start": "ng serve --configuration=development-opensource",
    "start:cloud": "ng serve --configuration=development-cloud",
    "start:cloud-kc": "ng serve --ssl --ssl-cert=$EXPLO_SSL_CERT --ssl-key=$EXPLO_SSL_KEY --configuration=development-cloud",
    "start:iam": "ng serve --ssl --ssl-cert=$EXPLO_SSL_CERT --ssl-key=$EXPLO_SSL_KEY --configuration=development-opensource",
    "build-opensource-stats": "ng build arlas-wui --configuration production-opensource --aot --base-href='$ARLAS_WUI_BASE_HREF/' --stats-json --metafile=meta.json",
    "build-opensource": "ng build arlas-wui --configuration production-opensource --aot --base-href='$ARLAS_WUI_BASE_HREF/'",
    "build-lib": "ng build arlas-wui-lib --configuration production",
    "analyze-opensource": "esbuild-visualizer --metadata dist/stats.json",
    "build-cloud": "ng build arlas-wui --configuration production-cloud --aot --base-href='$ARLAS_WUI_BASE_HREF/'",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "i18n:init": "ngx-translate-extract --input ./src --output ./src/assets/i18n/template.json --key-as-default-value --replace --format json",
    "i18n:extract": "ngx-translate-extract --input ./src --output ./src/assets/i18n/{en,fr,es}.json --format json",
    "license-check": "license-check-and-add check -f license-check-and-add.json"
  },
  "peerDependencies": {
    "@angular/animations": "^21.2.19",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.19",
    "@angular/platform-browser-dynamic": "^21.2.19",
    "@angular/router": "^21.2.19",
    "rxjs": "^7.4.0",
    "zone.js": "^0.15.1"
  },
  "dependencies": {
    "@colsen1991/ngx-translate-extract-marker": "^3.0.1",
    "@ngx-translate/core": "^17.0.0",
    "arlas-wui-toolkit": "29.0.0-rc.6",
    "hammerjs": "^2.0.8",
    "ng-packagr": "^21.2.2",
    "ngx-markdown": "~21.1.0",
    "web-animations-js": "^2.3.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.3.1",
    "@angular-eslint/eslint-plugin": "^21.3.1",
    "@angular-eslint/eslint-plugin-template": "^21.3.1",
    "@angular-eslint/schematics": "^21.3.1",
    "@angular-eslint/template-parser": "^21.3.1",
    "@angular/build": "^21.2.6",
    "@angular/cli": "^21.2.6",
    "@angular/compiler-cli": "^21.2.7",
    "@angular/language-service": "^21.2.7",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@vendure/ngx-translate-extract": "^10.1.3",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^9.39.1",
    "jsdom": "^29.0.2",
    "license-check-and-add": "^4.0.5",
    "node": "^24.10.1",
    "patch-package": "^8.0.1",
    "ts-node": "~10.4.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.3",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "overrides": {
    "underscore": "^1.13.8",
    "esbuild": "0.28.1",
    "undici": "7.29.0",
    "@hono/node-server": "2.0.10"
  }
}
