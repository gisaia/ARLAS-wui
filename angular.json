{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "cache": {
      "enabled": false
    }
  },
  "newProjectRoot": "projects",
  "projects": {
    "arlas-wui": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist",
              "browser": ""
            },
            "index": "src/index.html",
            "polyfills": [
              "src/polyfills.ts"
            ],
            "assets": [
              "src/assets",
              "src/favicon.ico",
              "src/config.json",
              "src/config.map.json",
              "src/settings.yaml",
              "src/silent-refresh.html",
              {
                "glob": "**/*",
                "input": "./node_modules/arlas-map/assets/icons/resize",
                "output": "/assets/icons/resize/"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/arlas-map/assets/icons/rotate",
                "output": "/assets/icons/rotate/"
              }
            ],
            "styles": [
              "src/styles/variables.scss",
              "src/styles/arlas-wui-theme.scss",
              "src/styles.scss",
              "node_modules/iv-viewer/dist/iv-viewer.css",
              "node_modules/@mapbox/mapbox-gl-draw/dist/mapbox-gl-draw.css",
              "node_modules/arlas-web-components/assets/styles.css"
            ]
          },
          "configurations": {
            "development": {
              "optimization": false,
              "outputHashing": "all",
              "sourceMap": true,
              "browser": "src/main.ts",
              "tsConfig": "src/tsconfig.app.json",
              "styles": [
                "src/styles/variables.scss",
                "src/styles/arlas-wui-theme.scss",
                "src/styles.scss",
                "node_modules/iv-viewer/dist/iv-viewer.css"
              ],
              "namedChunks": true,
              "extractLicenses": false,
              "budgets": []
            },
            "development-opensource": {
              "optimization": false,
              "outputHashing": "all",
              "sourceMap": true,
              "browser": "src/main-opensource.ts",
              "tsConfig": "src/tsconfig.app.opensource.json",
              "styles": [
                "src/styles/variables.scss",
                "src/styles/arlas-wui-theme.scss",
                "src/styles.scss",
                "node_modules/iv-viewer/dist/iv-viewer.css",
                "node_modules/@mapbox/mapbox-gl-draw/dist/mapbox-gl-draw.css",
                "node_modules/maplibre-gl/dist/maplibre-gl.css",
                "node_modules/arlas-web-components/assets/styles.css"
              ],
              "namedChunks": true,
              "extractLicenses": false,
              "budgets": [],
              "assets": [
                {
                  "input": "src/",
                  "output": "/",
                  "glob": "settings.yaml"
                },
                {
                  "input": "src/",
                  "output": "/",
                  "glob": "config.json"
                },
                {
                  "input": "src/",
                  "output": "/",
                  "glob": "config.map.json"
                },
                "src/assets",
                "src/silent-refresh.html",
                "src/favicon.ico",
                {
                  "glob": "**/*",
                  "input": "./node_modules/arlas-map/assets/icons/resize",
                  "output": "/assets/icons/resize/"
                },
                {
                  "glob": "**/*",
                  "input": "./node_modules/arlas-map/assets/icons/rotate",
                  "output": "/assets/icons/rotate/"
                },
                {
                  "glob": "**/*",
                  "input": "src/environments/local/i18n",
                  "output": "/assets/i18n/custom"
                }
              ]
            },
            "development-cloud": {
              "optimization": false,
              "outputHashing": "all",
              "sourceMap": true,
              "browser": "src/main-cloud.ts",
              "tsConfig": "src/tsconfig.app.cloud.json",
              "scripts": [
                "node_modules/mapbox-gl/dist/mapbox-gl.js"
              ],
              "styles": [
                "src/styles/variables.scss",
                "src/styles/arlas-wui-theme.scss",
                "src/styles.scss",
                "node_modules/iv-viewer/dist/iv-viewer.css",
                "node_modules/@mapbox/mapbox-gl-draw/dist/mapbox-gl-draw.css",
                "node_modules/mapbox-gl/dist/mapbox-gl.css",
                "node_modules/arlas-web-components/assets/styles.css"
              ],
              "namedChunks": true,
              "extractLicenses": false,
              "budgets": [],
              "assets": [
                {
                  "input": "src/",
                  "output": "/",
                  "glob": "settings.yaml"
                },
                {
                  "input": "src/",
                  "output": "/",
                  "glob": "config.json"
                },
                {
                  "input": "src/",
                  "output": "/",
                  "glob": "config.map.json"
                },
                "src/assets",
                "src/silent-refresh.html",
                "src/favicon.ico",
                {
                  "glob": "**/*",
                  "input": "./node_modules/arlas-map/assets/icons/resize",
                  "output": "/assets/icons/resize/"
                },
                {
                  "glob": "**/*",
                  "input": "./node_modules/arlas-map/assets/icons/rotate",
                  "output": "/assets/icons/rotate/"
                },
                {
                  "glob": "**/*",
                  "input": "src/environments/local/i18n",
                  "output": "/assets/i18n/custom"
                }
              ]
            },
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "assets": [
                {
                  "input": "src/environments/prod/",
                  "output": "/",
                  "glob": "*.yaml"
                },
                "src/assets",
                "src/silent-refresh.html",
                "src/favicon.ico",
                {
                  "glob": "**/*",
                  "input": "./node_modules/arlas-map/assets/icons/resize",
                  "output": "/assets/icons/resize/"
                },
                {
                  "glob": "**/*",
                  "input": "./node_modules/arlas-map/assets/icons/rotate",
                  "output": "/assets/icons/rotate/"
                },
                {
                  "glob": "**/*",
                  "input": "src/environments/prod/i18n",
                  "output": "/assets/i18n/custom"
                }
              ]
            },
            "production-opensource": {
              "optimization": true,
              "outputHashing": "all",
              "browser": "src/main-opensource.ts",
              "tsConfig": "src/tsconfig.app.opensource.json",
              "styles": [
                "src/styles/variables.scss",
                "src/styles/arlas-wui-theme.scss",
                "src/styles.scss",
                "node_modules/iv-viewer/dist/iv-viewer.css",
                "node_modules/@mapbox/mapbox-gl-draw/dist/mapbox-gl-draw.css",
                "node_modules/maplibre-gl/dist/maplibre-gl.css",
                "node_modules/arlas-web-components/assets/styles.css"
              ],
              "index": {
                "input": "src/index-without-analytics.html",
                "output": "index.html"
              },
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "assets": [
                {
                  "input": "src/environments/prod/",
                  "output": "/",
                  "glob": "*.yaml"
                },
                "src/assets",
                "src/silent-refresh.html",
                "src/favicon.ico",
                {
                  "glob": "**/*",
                  "input": "./node_modules/arlas-map/assets/icons/resize",
                  "output": "/assets/icons/resize/"
                },
                {
                  "glob": "**/*",
                  "input": "./node_modules/arlas-map/assets/icons/rotate",
                  "output": "/assets/icons/rotate/"
                },
                {
                  "glob": "**/*",
                  "input": "src/environments/prod/i18n",
                  "output": "/assets/i18n/custom"
                }
              ]
            },
            "production-cloud": {
              "optimization": false,
              "outputHashing": "all",
              "browser": "src/main-cloud.ts",
              "tsConfig": "src/tsconfig.app.cloud.json",
              "styles": [
                "src/styles/variables.scss",
                "src/styles/arlas-wui-theme.scss",
                "src/styles.scss",
                "node_modules/iv-viewer/dist/iv-viewer.css",
                "node_modules/@mapbox/mapbox-gl-draw/dist/mapbox-gl-draw.css",
                "node_modules/mapbox-gl/dist/mapbox-gl.css",
                "node_modules/arlas-web-components/assets/styles.css"
              ],
              "scripts": [
                "node_modules/mapbox-gl/dist/mapbox-gl.js"
              ],
              "index": {
                "input": "src/index.html",
                "output": "index.html"
              },
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "assets": [
                {
                  "input": "src/environments/prod/",
                  "output": "/",
                  "glob": "*.yaml"
                },
                "src/assets",
                "src/silent-refresh.html",
                "src/favicon.ico",
                {
                  "glob": "**/*",
                  "input": "./node_modules/arlas-map/assets/icons/resize",
                  "output": "/assets/icons/resize/"
                },
                {
                  "glob": "**/*",
                  "input": "./node_modules/arlas-map/assets/icons/rotate",
                  "output": "/assets/icons/rotate/"
                },
                {
                  "glob": "**/*",
                  "input": "src/environments/prod/i18n",
                  "output": "/assets/i18n/custom"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "arlas-wui:build"
          },
          "configurations": {
            "development": {
              "buildTarget": "arlas-wui:build:development"
            },
            "development-opensource": {
              "buildTarget": "arlas-wui:build:development-opensource"
            },
            "development-cloud": {
              "buildTarget": "arlas-wui:build:development-cloud"
            },
            "production-cloud": {
              "buildTarget": "arlas-wui:build:production-cloud"
            },
            "production-opensource": {
              "buildTarget": "arlas-wui:build:production-opensource"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "arlas-wui:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "src/tsconfig.spec.json",
            "watch": false
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "eslintConfig": "eslint.config.mjs",
            "lintFilePatterns": [
              "src/**/*.spec.ts",
              "src/**/*.d.ts",
              "src/**/*.ts"
            ]
          }
        }
      }
    },
    "arlas-wui-lib": {
      "projectType": "library",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "tsConfig": "tsconfig.lib.json",
            "project": "ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "tsconfig.lib.prod.json"
            }
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "project": "arlas-wui",
      "prefix": "arlas",
      "style": "scss",
      "type": "component"
    },
    "@schematics/angular:directive": {
      "project": "arlas-wui",
      "prefix": "arlas",
      "type": "directive"
    },
    "@angular-eslint/schematics:application": {
      "setParserOptionsProject": true
    },
    "@angular-eslint/schematics:library": {
      "setParserOptionsProject": true
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
