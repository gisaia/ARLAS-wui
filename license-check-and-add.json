{
    "ignore": [".github/**", ".git/**", "e2e/**", "*", "**/*.cjs", "**/*.sh", "*.yml", "**/*.yaml", "**/*.conf", "**/*.md", "**/*.svg", "**/*.spec.ts", "**/*.html", "**/*.woff2", "**/.DS_Store", "**/.gitkeep", "patches/*", "**/*.xml", "**/*.csv", "docker/*", "src/assets/basemap"],
    "license": "LICENSE",
    "trailingWhitespace": "TRIM",
    "licenseFormats": {
        "ts|js|css|scss": {
            "prepend": "/*",
            "append": " */",
            "eachLine": {
                "prepend": " * "
            }
        }
    }
}